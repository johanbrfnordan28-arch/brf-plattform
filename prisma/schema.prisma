// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Produktion: Supabase / Neon / Vercel Postgres (postgresql).
// Lokalt utan moln: tillfällig SQLite kräver separat schema — använd DATABASE_URL till Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direktanslutning (utan pooler) — används av Prisma Migrate.
  directUrl = env("DIRECT_URL")
}

/// Förening som sparats på servern (speglas från webbläsaren).
model Forening {
  id                   String    @id
  namn                 String
  /// Normaliserat namn för unikhet / sök (gemener, utan accenter).
  namnNyckel           String    @unique
  organisationsnummer  String    @default("")
  epost                String    @default("")
  postadress           String    @default("")
  ort                  String    @default("")
  postnummer           String    @default("")
  kontaktperson        String    @default("")
  grundinfoPaborjad    Boolean   @default(false)
  avtalGodkant         Boolean   @default(false)
  avtalGodkantTidpunkt DateTime?
  /// BankID-signering av avtal (ISO när signering slutfördes).
  avtalBankidTidpunkt  DateTime?
  avtalBankidNamn      String    @default("")
  /// Hemlig nyckel — behålls för bakåtkompatibilitet tills alla flöden använder konto.
  accessNyckelHash     String
  skapadTidpunkt       DateTime  @default(now())
  uppdateradTidpunkt   DateTime  @updatedAt

  medlemmar            ForeningMedlem[]
  inloggningar         InloggningsHistorik[]
}

/// Inloggningskonto — styrelseledamot eller dold plattformsadmin.
model Konto {
  id           String   @id
  epost        String
  epostNyckel  String   @unique
  namn         String   @default("")
  losnordHash  String
  /// Krypterat aktuellt lösenord — avkrypteras endast för den inloggade ägaren.
  losenordKuvert String @default("")
  /// STYRELSE | PLATTFORM — PLATTFORM syns aldrig för styrelsen.
  typ          String
  aktiv        Boolean  @default(true)
  senasteInloggning DateTime?
  skapadTidpunkt DateTime @default(now())
  uppdateradTidpunkt DateTime @updatedAt

  medlemskap   ForeningMedlem[]
  aterstallningar LosnordAterstallning[]
  inloggningar InloggningsHistorik[]
}

/// Styrelsemedlemskap i en förening (max 10 per förening i applikationslogik).
model ForeningMedlem {
  id         String   @id
  foreningId String
  kontoId    String
  /// Ordförande, Sekreterare, Förvaltare, Projektledare, …
  roll       String
  skapadTidpunkt DateTime @default(now())

  forening Forening @relation(fields: [foreningId], references: [id], onDelete: Cascade)
  konto    Konto    @relation(fields: [kontoId], references: [id], onDelete: Cascade)

  @@unique([foreningId, kontoId])
  @@index([kontoId])
}

model LosnordAterstallning {
  id         String   @id
  kontoId    String
  tokenHash  String   @unique
  utgar      DateTime
  anvand     Boolean  @default(false)
  skapadTidpunkt DateTime @default(now())

  konto Konto @relation(fields: [kontoId], references: [id], onDelete: Cascade)

  @@index([kontoId])
}

/// Synlig endast för plattformsadmin — aldrig för styrelsen.
model InloggningsHistorik {
  id         String   @id
  kontoId    String?
  epost      String
  /// STYRELSE | PLATTFORM
  typ        String
  foreningId String?
  lyckad     Boolean
  ip         String   @default("")
  userAgent  String   @default("")
  tidpunkt   DateTime @default(now())

  konto    Konto?    @relation(fields: [kontoId], references: [id], onDelete: SetNull)
  forening Forening? @relation(fields: [foreningId], references: [id], onDelete: SetNull)

  @@index([tidpunkt])
  @@index([epost])
}

/// Mejl som skulle skickats (dev/demo utan SMTP) — plattformsadmin kan se outbox.
model MejlOutbox {
  id       String   @id
  till     String
  amne     String
  brodtext String
  skickadVia String @default("outbox")
  skapadTidpunkt DateTime @default(now())
}

/// Mål och intern uppföljning — endast plattformsadmin.
model PlattformMal {
  id              String   @id @default("default")
  /// Mål: antal föreningar med tecknat avtal.
  malAvtal        Int      @default(10)
  /// Mål: antal aktuella testföreningar (pågående prövoperiod).
  malTest         Int      @default(20)
  uppdateradTidpunkt DateTime @updatedAt
  uppdateradAvEpost  String @default("")
}
