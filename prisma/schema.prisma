// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Produktion: Supabase / Neon / Vercel Postgres (postgresql).
// Lokalt utan moln: tillfällig SQLite kräver separat schema — använd DATABASE_URL till Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direktanslutning (utan pooler) — används av Prisma Migrate.
  directUrl = env("DIRECT_URL")
}

/// Förening som sparats på servern (speglas från webbläsaren).
model Forening {
  id                   String    @id
  namn                 String
  /// Normaliserat namn för unikhet / sök (gemener, utan accenter).
  namnNyckel           String    @unique
  organisationsnummer  String    @default("")
  epost                String    @default("")
  postadress           String    @default("")
  ort                  String    @default("")
  postnummer           String    @default("")
  kontaktperson        String    @default("")
  grundinfoPaborjad    Boolean   @default(false)
  avtalGodkant         Boolean   @default(false)
  avtalGodkantTidpunkt DateTime?
  /// BankID-signering av avtal (ISO när signering slutfördes).
  avtalBankidTidpunkt  DateTime?
  avtalBankidNamn      String    @default("")
  /// Hemlig nyckel — behålls för bakåtkompatibilitet tills alla flöden använder konto.
  accessNyckelHash     String
  /// Soft-delete — föreningen syns under «Borttagna» i plattformen.
  borttagenTidpunkt    DateTime?
  borttagenAvEpost     String    @default("")
  skapadTidpunkt       DateTime  @default(now())
  uppdateradTidpunkt   DateTime  @updatedAt

  medlemmar            ForeningMedlem[]
  inloggningar         InloggningsHistorik[]
  sakerhetskopior      ForeningSakerhetskopia[]
}

/// Inloggningskonto — styrelseledamot eller dold plattformsadmin.
model Konto {
  id           String   @id
  epost        String
  epostNyckel  String   @unique
  namn         String   @default("")
  losnordHash  String
  /// Krypterat aktuellt lösenord — avkrypteras endast för den inloggade ägaren.
  losenordKuvert String @default("")
  /// STYRELSE | PLATTFORM — PLATTFORM syns aldrig för styrelsen.
  typ          String
  aktiv        Boolean  @default(true)
  senasteInloggning DateTime?
  skapadTidpunkt DateTime @default(now())
  uppdateradTidpunkt DateTime @updatedAt

  medlemskap   ForeningMedlem[]
  aterstallningar LosnordAterstallning[]
  inloggningar InloggningsHistorik[]
}

/// Styrelsemedlemskap i en förening (max 10 per förening i applikationslogik).
model ForeningMedlem {
  id         String   @id
  foreningId String
  kontoId    String
  /// Ordförande, Sekreterare, Förvaltare, Projektledare, …
  roll       String
  skapadTidpunkt DateTime @default(now())

  forening Forening @relation(fields: [foreningId], references: [id], onDelete: Cascade)
  konto    Konto    @relation(fields: [kontoId], references: [id], onDelete: Cascade)

  @@unique([foreningId, kontoId])
  @@index([kontoId])
}

model LosnordAterstallning {
  id         String   @id
  kontoId    String
  tokenHash  String   @unique
  utgar      DateTime
  anvand     Boolean  @default(false)
  skapadTidpunkt DateTime @default(now())

  konto Konto @relation(fields: [kontoId], references: [id], onDelete: Cascade)

  @@index([kontoId])
}

/// Synlig endast för plattformsadmin — aldrig för styrelsen.
model InloggningsHistorik {
  id         String   @id
  kontoId    String?
  epost      String
  /// STYRELSE | PLATTFORM
  typ        String
  foreningId String?
  lyckad     Boolean
  ip         String   @default("")
  userAgent  String   @default("")
  tidpunkt   DateTime @default(now())

  konto    Konto?    @relation(fields: [kontoId], references: [id], onDelete: SetNull)
  forening Forening? @relation(fields: [foreningId], references: [id], onDelete: SetNull)

  @@index([tidpunkt])
  @@index([epost])
}

/// Mejl som skulle skickats (dev/demo utan SMTP) — plattformsadmin kan se outbox.
model MejlOutbox {
  id       String   @id
  till     String
  amne     String
  brodtext String
  skickadVia String @default("outbox")
  skapadTidpunkt DateTime @default(now())
}

/// Intern inställning (t.ex. varning för många testföreningar).
model PlattformInstallning {
  id                 String   @id @default("default")
  /// Varning när antalet aktuella testföreningar når eller överstiger detta.
  varningTestAntal  Int      @default(25)
  /// Namn på aktuell mässa, t.ex. «STOFF Stockholm 2026».
  inbjudanMassaNamn  String   @default("")
  inbjudanMassaHuvudsidaRubrik String @default("")
  inbjudanMassaHuvudsidaIntro  String @default("")
  inbjudanMassaMejlAmne          String @default("")
  inbjudanMassaMejlMall          String @default("")
  inbjudanPersonligMejlAmne      String @default("")
  inbjudanPersonligMejlMall      String @default("")
  inbjudanMejlaLankRubrik        String @default("")
  inbjudanMejlaLankIntro         String @default("")
  uppdateradTidpunkt DateTime @updatedAt
  uppdateradAvEpost  String   @default("")
}

/// Ett mätbart mål med tidpunkt — flera kan finnas samtidigt.
model PlattformMalRad {
  id               String    @id
  /// avtal | test
  typ              String
  titel            String    @default("")
  malAntal         Int
  /// Måldatum / deadline.
  tidpunkt         DateTime
  uppfylld         Boolean   @default(false)
  uppfylldTidpunkt DateTime?
  aktiv            Boolean   @default(true)
  skapadTidpunkt   DateTime  @default(now())
  skapadAvEpost    String    @default("")
  uppdateradTidpunkt DateTime @updatedAt

  @@index([typ, aktiv])
  @@index([tidpunkt])
}

/// Säkerhetskopia av föreningens webbläsardata — lagras på våra servrar.
model ForeningSakerhetskopia {
  id             String   @id
  foreningId     String
  /// Snapshot av namnet vid kopiering (för listning).
  foreningsNamn  String
  filnamn        String
  exportedAt     DateTime
  version        Int      @default(1)
  antalNycklar   Int      @default(0)
  storlekBytes   Int      @default(0)
  /// Full backup-JSON (format brf-forening-backup).
  payload        Json
  skapadAvEpost  String   @default("")
  skapadTidpunkt DateTime @default(now())

  forening Forening @relation(fields: [foreningId], references: [id], onDelete: Cascade)

  @@index([foreningId, skapadTidpunkt])
  @@index([foreningsNamn])
}

/// Sparad personlig inbjudningsmall per personal (kan användas av hela teamet).
model PersonligInbjudanMall {
  id                 String   @id
  agareEpost         String
  titel              String
  avsandareNamn      String   @default("")
  mejlAmne           String
  mejlMall           String
  /// Förvald mall när denna person skickar inbjudan.
  arStandard         Boolean  @default(false)
  skapadTidpunkt     DateTime @default(now())
  uppdateradTidpunkt DateTime @updatedAt

  @@index([agareEpost])
  @@index([agareEpost, arStandard])
}

/// Intresse från styrelsemässa / «mejla mig en länk» — uppföljning i personalytan.
model StyrelsemassaLead {
  id                 String    @id
  foreningsNamn      String
  epost              String
  epostNyckel        String
  kontaktperson      String    @default("")
  telefon            String    @default("")
  /// lank_skickad | skapade_test
  status             String    @default("lank_skickad")
  /// massa_sjalv | personal | massa_lank
  kalla              String    @default("massa_sjalv")
  inbjudenAvNamn     String    @default("")
  inbjudenAvEpost    String    @default("")
  inbjudanMallId     String?
  inbjudanMallTitel  String    @default("")
  foreningId         String?
  skapadTidpunkt     DateTime  @default(now())
  testSkapadTidpunkt DateTime?
  mejlSkickad        Boolean   @default(false)

  @@index([epostNyckel])
  @@index([kalla])
  @@index([status])
  @@index([skapadTidpunkt])
}

