# Databas (Production: Supabase/Neon/Vercel Postgres)
DATABASE_URL=
DIRECT_URL=

# Auth
AUTH_SECRET=

# Publik webbadress
NEXT_PUBLIC_APP_URL=https://demo.styrelse-navet.se

# Mejl — välj Resend ELLER SMTP (Resend rekommenderas)
# Resend: skapa nyckel på https://resend.com eller installera Resend i Vercel Marketplace
RESEND_API_KEY=
MEJL_FRAN=Styrelse-Navet <offert@styrelse-navet.se>

# SMTP-alternativ (t.ex. er mailserver för styrelse-navet.se)
# SMTP_HOST=mail.styrelse-navet.se
# SMTP_PORT=587
# SMTP_USER=offert@styrelse-navet.se
# SMTP_PASS=
# SMTP_FROM=Styrelse-Navet <offert@styrelse-navet.se>

# Reservmottagare offert (valfritt, kommaseparerat)
# OFFERT_EPOST_RESERV=johan@styrelse-navet.se
