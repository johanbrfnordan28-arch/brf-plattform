# Databas — Supabase Postgres
# Kopiera exakt URI från Supabase → Connect (region/host kan vara aws-0-… eller aws-1-…).
# Transaction pooler (:6543 + pgbouncer=true) till DATABASE_URL (Vercel/serverless).
# Session pooler (:5432) till DIRECT_URL (Prisma migrate / db push).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Session-signering (HMAC) — lång slumpad sträng i produktion
AUTH_SECRET="byt-till-en-lang-slumpad-strang"

# Valfritt: Supabase API-nycklar (REST/Auth)
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_..."

# Publik bas-URL (mejllänkar för återställning)
# NEXT_PUBLIC_APP_URL="https://er-doman.se"

# Valfritt: skicka riktiga mejl via Resend
# RESEND_API_KEY="re_..."
# MEJL_FRAN="Styrelse-Navet <noreply@er-doman.se>"

# Plattformsadmin (kommaseparerat)
# PLATTFORM_ADMIN_EPOSTER="johancarlsen@icloud.com,person2@exempel.se"
