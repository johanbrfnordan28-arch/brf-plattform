# Databas — lokal utveckling (SQLite)
DATABASE_URL="file:./dev.db"

# Produktion (exempel Postgres / Neon / Supabase):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Session-signering (byt i produktion)
AUTH_SECRET="byt-till-en-lang-slumpad-strang"

# Publik bas-URL (mejllänkar)
# NEXT_PUBLIC_APP_URL="https://er-doman.se"

# Valfritt: skicka riktiga mejl via Resend
# RESEND_API_KEY="re_..."
# MEJL_FRAN="Styrelse-Navet <noreply@er-doman.se>"

